# Normalizing line endings: the repository stores LF, Windows tools get CRLF where needed.
* text=auto eol=lf

*.iss  text eol=crlf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ics  text eol=crlf

*.ico  binary
*.png  binary
*.jpg  binary
*.ttf  binary
*.exe  binary
*.pdf  binary
